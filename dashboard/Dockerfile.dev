FROM node:20-alpine

# Patch the base image: Alpine packages (openssl, musl, zlib) and the npm CLI
# bundled with node:20 (its tar/minimatch/cross-spawn/sigstore deps) carry
# HIGH/CRITICAL advisories. npm 11 is the newest line that supports Node 20.
RUN apk upgrade --no-cache \
    && npm install -g npm@11.21.3 \
    && npm cache clean --force

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
# npm ci installs exactly what package-lock.json pins (npm install may drift).
RUN npm ci

COPY --chown=node:node . .

EXPOSE 5173

CMD ["npm", "run", "dev"]
